# Copy this file to .env for local development.
# In production on Databricks Apps, LAKEBASE_URL is pulled from the
# "database/lakebase-url" secret via app.yaml — do NOT commit a filled-in .env.

LAKEBASE_URL=postgresql://<role>:<password>@<host>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require
